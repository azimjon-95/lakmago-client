# frozen_string_literal: true

# ═══════════════════════════════════════════════════════════════
# LOKMA GO — iOS AVTOMATIK DEPLOY (TestFlight / App Store)
# ═══════════════════════════════════════════════════════════════
#
# Ishga tushiruvchi: .github/workflows/ios-release.yml (macOS runner).
# To'liq sozlash va qoidalar: docs/IOS-DEPLOY.md
#
#   beta     — build → imzolash → TestFlight'ga yuklash (processing kutilmaydi)
#   release  — beta + processing kutiladi + App Store'ga "Submit for Review"
#              (avtomatik CHIQARILMAYDI: Apple tasdiqlagach qo'lda "Release")
#
# IMZOLASH: tarqatish sertifikati (.p12) GitHub Secret'dan vaqtinchalik
# keychain'ga olinadi; provisioning profile App Store Connect API orqali
# yuklab olinadi (yo'q bo'lsa yaratiladi). Loyihada (repo) imzolash
# "Automatic" bo'lib qoladi — "Manual"ga faqat CI nusxasida o'tkaziladi,
# commit qilinmaydi. Sertifikat/kalit DISKDA QOLMAYDI (ensure bloki).
#
# BUILD RAQAMI: max(TestFlight'dagi oxirgisi, loyihadagi) + 1 — har yuklash
# noyob (Apple takror raqamni rad etadi). Repo'dagi raqam o'zgartirilmaydi.
# VERSIYA: IOS_MARKETING_VERSION (git teg ios-v1.2.3 → 1.2.3) yoki loyihadagi.

require "base64"
require "fileutils"
require "tmpdir"

default_platform(:ios)

PROJECT = "App.xcodeproj"
SCHEME = "App"
TARGET = "App"
BUILD_DIR = File.expand_path("../build", __dir__)

def required_env(name)
  value = ENV[name].to_s.strip
  UI.user_error!("#{name} berilmagan (GitHub Secrets / Variables — docs/IOS-DEPLOY.md)") if value.empty?
  value
end

def bundle_id
  ENV.fetch("IOS_BUNDLE_ID", "uz.lokma.go")
end

def team
  ENV.fetch("APPLE_TEAM_ID", "8A38QL5HR2")
end

def asc_api_key
  @asc_api_key ||= app_store_connect_api_key(
    key_id: required_env("ASC_KEY_ID"),
    issuer_id: required_env("ASC_ISSUER_ID"),
    key_content: required_env("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true,
    duration: 1200,
    in_house: false
  )
end

def marketing_version
  v = ENV["IOS_MARKETING_VERSION"].to_s.strip
  return get_version_number(xcodeproj: PROJECT, target: TARGET) if v.empty?

  UI.user_error!("IOS_MARKETING_VERSION noto'g'ri: '#{v}' (kutilgan: 1.2 yoki 1.2.3)") unless v.match?(/\A\d+\.\d+(\.\d+)?\z/)
  v
end

def next_build_number(version)
  remote = latest_testflight_build_number(api_key: asc_api_key, app_identifier: bundle_id, version: version, initial_build_number: 0).to_i
  remote_any = latest_testflight_build_number(api_key: asc_api_key, app_identifier: bundle_id, initial_build_number: 0).to_i
  local = get_build_number(xcodeproj: PROJECT).to_i
  [remote, remote_any, local].max + 1
end

# Tarqatish sertifikatini vaqtinchalik keychain'ga o'rnatadi va App Store profilini oladi.
def prepare_signing
  setup_ci(force: true) # CI uchun vaqtinchalik keychain (fastlane_tmp_keychain)

  p12_path = File.join(Dir.tmpdir, "lokma_dist_#{Process.pid}.p12")
  File.binwrite(p12_path, Base64.decode64(required_env("IOS_DIST_CERT_P12_BASE64")))
  begin
    import_certificate(
      certificate_path: p12_path,
      certificate_password: required_env("IOS_DIST_CERT_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "",
      log_output: false
    )
  ensure
    FileUtils.rm_f(p12_path)
  end

  get_provisioning_profile(
    api_key: asc_api_key,
    app_identifier: bundle_id,
    team_id: team,
    readonly: false,                 # yo'q yoki eskirgan bo'lsa — yaratadi/yangilaydi
    skip_certificate_verification: false,
    output_path: File.join(BUILD_DIR, "profiles")
  )
  profile_name = lane_context[SharedValues::SIGH_NAME]

  # Faqat App target'i (SPM paketlariga profil berilsa build buziladi). CI nusxasida, commit qilinmaydi.
  update_code_signing_settings(
    path: PROJECT,
    use_automatic_signing: false,
    team_id: team,
    targets: [TARGET],
    bundle_identifier: bundle_id,
    code_sign_identity: "Apple Distribution",
    profile_name: profile_name
  )
  profile_name
end

def build_ipa(version, build_number, profile_name)
  FileUtils.mkdir_p(BUILD_DIR)
  build_app(
    project: PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    clean: true,
    export_method: "app-store",
    output_directory: BUILD_DIR,
    output_name: "LokmaGo.ipa",
    include_symbols: true,
    include_bitcode: false,
    cloned_source_packages_path: File.join(BUILD_DIR, "SourcePackages"),
    xcargs: "CURRENT_PROJECT_VERSION=#{build_number} MARKETING_VERSION=#{version}",
    export_options: {
      provisioningProfiles: { bundle_id => profile_name },
      manageAppVersionAndBuildNumber: false,
      uploadSymbols: true
    }
  )
end

def summary(lines)
  path = ENV["GITHUB_STEP_SUMMARY"]
  return if path.to_s.empty?

  File.open(path, "a") { |f| f.puts(lines.join("\n")) }
end

def ship(submit:)
  version = marketing_version
  build_number = next_build_number(version)
  UI.important("Lokma Go #{version} (#{build_number}) → #{submit ? 'App Store (Submit for Review)' : 'TestFlight'}")

  profile_name = prepare_signing
  ipa = build_ipa(version, build_number, profile_name)

  upload_to_testflight(
    api_key: asc_api_key,
    ipa: ipa,
    app_identifier: bundle_id,
    skip_waiting_for_build_processing: !submit, # beta: kutilmaydi (macOS daqiqalari tejaladi)
    distribute_external: false
  )

  if submit
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: bundle_id,
      app_version: version,
      build_number: build_number.to_s,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false, # Apple tasdiqlagach — qo'lda "Release this version"
      force: true,              # HTML preview so'ralmaydi (CI)
      run_precheck_before_submit: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
  end

  summary([
    "### Lokma Go iOS",
    "",
    "| | |",
    "|---|---|",
    "| Versiya | `#{version}` |",
    "| Build | `#{build_number}` |",
    "| Natija | #{submit ? 'TestFlight + **Submit for Review**' : 'TestFlight (processing ~10–30 daqiqa)'} |"
  ])
end

platform :ios do
  desc "Build → TestFlight (ichki testerlar)"
  lane :beta do
    ship(submit: false)
  end

  desc "Build → TestFlight → App Store 'Submit for Review' (chiqarish qo'lda)"
  lane :release do
    ship(submit: true)
  end

  error do |lane, exception|
    summary(["### Lokma Go iOS — XATO (#{lane})", "", "```", exception.message.to_s[0, 1500], "```"])
  end
end
